# Signs and encrypts checkout sessions, orders and ticket QR codes.
# Use a long random value in production (e.g. `openssl rand -base64 48`).
# Changing it invalidates every ticket already issued.
TICKET_SECRET=

# Stripe (Dashboard > Developers > API keys). sk_test_ in the sandbox,
# sk_live_ when selling for real. Without it every ticket uses the mock.
STRIPE_SECRET_KEY=
# Price ids (price_...), one-off, in PLN, each matching the price on the
# page. A ticket without a price id stays on the mock checkout.
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_VIP_4_5=
STRIPE_PRICE_VIP_6_8=
STRIPE_PRICE_VIP_8_10=
# The webhook's signing secret (whsec_...): from `stripe listen` locally,
# from Dashboard > Developers > Webhooks in production.
STRIPE_WEBHOOK_SECRET=

# The PIN door staff enter once per phone at /staff to get the «Впустити»
# button on scanned tickets. Use 6+ digits. Without it, staff sign-in is off
# in production (locally it is 1234).
STAFF_PIN=

# Upstash Redis, where check-ins are kept (Vercel > Storage > Upstash adds
# these two). Required in production for the door check; locally a file in
# .data/ stands in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend (resend.com > API keys, Sending access). Without it, ticket emails
# are only written to .data/outbox (and on Vercel, not sent at all).
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=Wonderland Club <tickets@wonderlandkrk.club>
# Optional: where replies to the ticket email go.
EMAIL_REPLY_TO=
